# Copy selected settings into .env; existing .env is preserved.
ROUTER_DEFAULT_MODEL=qwen2.5-coder:3b
ROUTER_REPORT_MODEL=qwen2.5-coder:3b
ROUTER_NUM_CTX=4096
ROUTER_MAX_TOKENS=512
ROUTER_TIMEOUT=120
ROUTER_KEEP_ALIVE=10m
ROUTER_MAX_HISTORY=8
ROUTER_MAX_SESSIONS=64
ROUTER_MAX_ATTEMPTS=2


# Repository and online operations
ROUTER_WORKSPACE_ROOT=D:/MCP-Ollama-Router
ROUTER_CHECK_TIMEOUT=120
# ROUTER_CHECK_COMMANDS={"tests":["{python}","-m","pytest","-o","addopts=","-q"]}
ROUTER_ENABLE_GIT_NETWORK=false
ROUTER_ENABLE_PUBLISH=false
# ROUTER_GITHUB_TOKEN=

# Optional authenticated HTTP; stdio remains the default
ROUTER_TRANSPORT=stdio
ROUTER_HTTP_HOST=127.0.0.1
ROUTER_HTTP_PORT=8000
ROUTER_HTTP_PUBLIC_URL=http://127.0.0.1:8000
# Host-only random secret >=32 characters:
# ROUTER_JWT_SECRET=
ROUTER_JWT_ISSUER=mcp-ollama-router
ROUTER_JWT_AUDIENCE=mcp-ollama-router
# ROUTER_JWT_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# ROUTER_AUTHORIZATION_SERVERS=["https://auth.example.com"]
ROUTER_HTTP_ALLOWED_HOSTS=["127.0.0.1","localhost"]
ROUTER_HTTP_ALLOWED_ORIGINS=[]
