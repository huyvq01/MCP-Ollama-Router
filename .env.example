# Copy to .env, then configure; do not commit .env.
ROUTER_OLLAMA_BASE_URL=http://127.0.0.1:11434
ROUTER_GATEWAY_HOST=127.0.0.1
ROUTER_GATEWAY_PORT=8080
# Required only for the HTTP gateway. Generate a random key; do not use a sample key.
ROUTER_GATEWAY_API_KEY=
ROUTER_MAX_CONCURRENT=1
ROUTER_MAX_PENDING=8
ROUTER_MAX_ATTEMPTS=2
ROUTER_REQUEST_TIMEOUT_S=90
ROUTER_ATTEMPT_TIMEOUT_S=45
ROUTER_QUEUE_TIMEOUT_S=5
ROUTER_CONTEXT_TOKENS=4096
ROUTER_GATEWAY_CONTEXT_TOKENS=8192
ROUTER_MAX_OUTPUT_TOKENS=2048
ROUTER_MAX_MODEL_BILLIONS=8
ROUTER_ALLOW_UNKNOWN_MODEL_SIZE=false
ROUTER_MAX_SESSIONS=256
ROUTER_SESSION_TTL_S=3600
ROUTER_LOG_LEVEL=INFO
